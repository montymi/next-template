{
	"name": "next-template",
	"version": "2.0.0",
	"private": true,
	"scripts": {
		"dev": "next dev --webpack",
		"prebuild": "npm run brand && npm run messages",
		"build": "next build --webpack",
		"start": "next start",
		"lint": "eslint src scripts tests next.config.ts playwright.config.ts",
		"format": "prettier --write .",
		"prepare": "husky",
		"test": "npm run build && playwright test",
		"icons": "node scripts/generate-icons.mjs",
		"typecheck": "next typegen && tsc --noEmit",
		"tokens": "node scripts/generate-tokens.mjs",
		"test:e2e": "playwright test",
		"test:ui": "playwright test --ui",
		"test:report": "playwright show-report",
		"brand": "npm run tokens && npm run icons",
		"messages": "node scripts/validate-messages.mjs",
		"customize": "node scripts/apply-starter.mjs",
		"predev": "npm run brand"
	},
	"dependencies": {
		"@serwist/next": "9.5.14",
		"fflate": "0.8.3",
		"next": "16.4.6",
		"next-intl": "4.15.1",
		"next-themes": "0.4.6",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"serwist": "9.5.14"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.6.1",
		"@commitlint/config-conventional": "^19.6.0",
		"@playwright/test": "1.65.1",
		"@serwist/cli": "9.5.14",
		"@tailwindcss/postcss": "4.3.5",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.6",
		"husky": "9.1.7",
		"postcss": "8.5.33",
		"prettier": "^3.0.3",
		"tailwindcss": "4.3.5",
		"typescript": "5.9.3"
	},
	"prettier": {
		"semi": false,
		"singleQuote": true,
		"jsxSingleQuote": true,
		"useTabs": true
	},
	"type": "module",
	"engines": {
		"node": "24.x"
	}
}

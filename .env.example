# Optional canonical HTTPS origin for metadata and shared-link images.
# Vercel supplies a hostname automatically. Never put credentials in NEXT_PUBLIC_ values.
NEXT_PUBLIC_SITE_URL=

# Optional: enable saved-configuration forks through a GitHub OAuth app.
# Keep these server-only. Create the app in GitHub Developer settings.
# Generate GITHUB_SESSION_SECRET with: openssl rand -hex 32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SESSION_SECRET=
GITHUB_CALLBACK_URL=
